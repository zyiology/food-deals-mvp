# Register at https://www.onemap.gov.sg/apidocs/register
# The server uses these credentials only to obtain short-lived OneMap API tokens.
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-password

# Used only by the offline classify-meals command.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional temporary alternative. Tokens expire after three days and cannot renew.
# ONEMAP_TOKEN=your-short-lived-token
